{
	"name": "@strikebook/core",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "Framework-free domain logic: trade model, position engine, options math, analytics, market data.",
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./src/index.ts",
			"default": "./src/index.ts"
		},
		"./market-data": {
			"types": "./src/market-data/index.ts",
			"default": "./src/market-data/index.ts"
		},
		"./sample": {
			"types": "./src/sample/index.ts",
			"default": "./src/sample/index.ts"
		}
	},
	"imports": {
		"#core/*": "./src/*"
	},
	"scripts": {
		"check": "tsc --noEmit -p tsconfig.json",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"dependencies": {
		"valibot": "catalog:"
	},
	"devDependencies": {
		"@types/node": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	}
}
