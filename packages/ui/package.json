{
	"name": "@strikebook/ui",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "Shared Svelte 5 design system, charts and application screens for web and desktop.",
	"sideEffects": ["**/*.css"],
	"svelte": "./src/index.ts",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"svelte": "./src/index.ts",
			"default": "./src/index.ts"
		},
		"./styles.css": "./src/styles/index.css",
		"./marketing": {
			"types": "./src/marketing/index.ts",
			"svelte": "./src/marketing/index.ts",
			"default": "./src/marketing/index.ts"
		}
	},
	"imports": {
		"#ui/*": "./src/*"
	},
	"scripts": {
		"check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
		"test": "echo \"ui is exercised by the app test suites\""
	},
	"dependencies": {
		"@fontsource-variable/ibm-plex-sans": "catalog:",
		"@fontsource/ibm-plex-mono": "catalog:",
		"@strikebook/core": "workspace:*",
		"d3": "catalog:",
		"lightweight-charts": "catalog:",
		"phosphor-svelte": "catalog:",
		"valibot": "catalog:"
	},
	"peerDependencies": {
		"svelte": "^5.57.1"
	},
	"devDependencies": {
		"@types/d3": "catalog:",
		"svelte": "catalog:",
		"svelte-check": "catalog:",
		"typescript": "catalog:"
	}
}
