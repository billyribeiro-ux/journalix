{
	"name": "strikebook",
	"private": true,
	"type": "module",
	"description": "Options-first trading journal — web and desktop.",
	"engines": {
		"node": ">=24.22.0 <25"
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": "24.22.0",
			"onFail": "error"
		},
		"packageManager": {
			"name": "pnpm",
			"version": "12.14.0",
			"onFail": "download"
		}
	},
	"scripts": {
		"dev:web": "pnpm --filter @strikebook/web dev",
		"dev:desktop": "pnpm --filter @strikebook/desktop tauri dev",
		"build": "pnpm -r build",
		"check": "pnpm -r check",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test": "pnpm -r test",
		"verify": "pnpm lint && pnpm check && pnpm test && pnpm build"
	},
	"devDependencies": {
		"@eslint/js": "catalog:",
		"eslint": "catalog:",
		"eslint-config-prettier": "catalog:",
		"eslint-plugin-svelte": "catalog:",
		"globals": "catalog:",
		"prettier": "catalog:",
		"prettier-plugin-svelte": "catalog:",
		"svelte": "catalog:",
		"typescript": "catalog:",
		"typescript-eslint": "catalog:"
	}
}
