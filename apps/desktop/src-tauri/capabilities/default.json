{
	"$schema": "../gen/schemas/desktop-schema.json",
	"identifier": "default",
	"description": "Main window: core defaults, the journal commands, and HTTPS fetches to the supported market-data providers only.",
	"windows": ["main"],
	"permissions": [
		"core:default",
		"journal",
		{
			"identifier": "http:default",
			"allow": [
				{ "url": "https://api.massive.com/*" },
				{ "url": "https://api.polygon.io/*" },
				{ "url": "https://data.alpaca.markets/*" },
				{ "url": "https://api.tiingo.com/*" },
				{ "url": "https://hist.databento.com/*" }
			]
		}
	]
}
